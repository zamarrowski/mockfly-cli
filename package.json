{
  "name": "mockfly-cli",
  "version": "0.4.0",
  "description": "Serve your Mockfly mock APIs locally, offline. Pull your projects once, mock without internet.",
  "type": "module",
  "license": "MIT",
  "author": "Sergio Zamarro (https://github.com/zamarrowski)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamarrowski/mockfly-cli.git"
  },
  "homepage": "https://github.com/zamarrowski/mockfly-cli#readme",
  "bugs": {
    "url": "https://github.com/zamarrowski/mockfly-cli/issues"
  },
  "bin": {
    "mockfly": "./bin/mockfly.js"
  },
  "files": [
    "bin",
    "src",
    "assets"
  ],
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=99 --test-coverage-functions=100 tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"bin/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"bin/*.js\" \"*.js\"",
    "postinstall": "test -d .githooks && git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "mock",
    "api",
    "mock-server",
    "offline",
    "mockfly"
  ],
  "dependencies": {
    "@faker-js/faker": "9.9.0",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "jsonpath-plus": "^10.4.0",
    "xmldom": "0.6.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "prettier": "2.0.5"
  }
}
